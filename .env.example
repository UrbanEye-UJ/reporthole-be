# Jasypt master password — decrypts ENC(...) values in application*.yml
JASYPT_ENCRYPTOR_PASSWORD=

# PostgreSQL credentials (used by both the postgres container and the Spring Boot app)
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# Directory on the host where PostgreSQL data is persisted
POSTGRES_DATA_DIR=postgres-data

# Spring profile: local | prod
SPRING_PROFILES_ACTIVE=local

# AES key for encrypting reporter PII at rest
REPORTHOLE_AES_KEY=

# JWT signing key
REPORTHOLE_JWT_KEY=

# Gmail SMTP credentials
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# URL at which the backend API is reachable externally (used to construct image URLs stored in DB)
# Local:  http://localhost:8080/api
# OCI:    https://<public-ip>/api
SERVICES_WEB_BASE_URL=

# Public-facing frontend base URL (used in verification and password-reset email links)
# Local:  https://localhost:3000
# OCI:    https://<public-ip>
SERVICES_WEB_BASE_URL_FRONTEND=

# Frontend URL passed to the Next.js Docker build
# Local:  http://localhost:8080/api
# OCI:    https://<public-ip>
NEXT_PUBLIC_API_URL=

# Caddy reverse proxy config
# CADDY_SITE_ADDRESS: hostname or IP Caddy serves — determines the TLS cert SAN
#   Local:  localhost
#   OCI:    <public-ip>
# CADDY_TLS_MODE: internal (self-signed/Caddy CA) | <email> (Let's Encrypt, requires a domain)
CADDY_SITE_ADDRESS=
CADDY_TLS_MODE=internal

# Caddy upstream targets
# Local (native BE/FE): host.docker.internal
# OCI (all containerised): reporthole-be / reporthole-fe
BACKEND_HOST=
BACKEND_PORT=8080
FRONTEND_HOST=
FRONTEND_PORT=3000
