# Jasypt master password — decrypts ENC(...) values in application*.yml
JASYPT_ENCRYPTOR_PASSWORD=

# PostgreSQL credentials (used by both the postgres container and the Spring Boot app)
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# URL at which the app is reachable externally (used to construct image URLs stored in DB)
# Example: http://localhost:8080/api
SERVICES_WEB_BASE_URL=

# Spring profile: local | dev | prod
SPRING_PROFILES_ACTIVE=local

# AES key for encrypting reporter PII at rest
REPORTHOLE_AES_KEY=

# JWT signing key
REPORTHOLE_JWT_KEY=
