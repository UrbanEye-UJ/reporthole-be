{$CADDY_SITE_ADDRESS} {
	tls {$CADDY_TLS_MODE}

	handle /api/incidents/events {
		reverse_proxy {$BACKEND_HOST}:{$BACKEND_PORT} host.docker.internal:{$BACKEND_PORT} {
			lb_policy first
			health_uri /api/actuator/health
			health_interval 5s
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy {$BACKEND_HOST}:{$BACKEND_PORT} host.docker.internal:{$BACKEND_PORT} {
			lb_policy first
			health_uri /api/actuator/health
			health_interval 5s
		}
	}

	# Dev/ops tooling — internal use only, no auth. Not gated on the app (pgAdmin/Dozzle
	# come up independently of reporthole-be/reporthole-ui) and not gated on a login,
	# so these stay reachable even when the app containers are down.
	@pgadmin path /pgadmin /pgadmin/*
	handle @pgadmin {
		reverse_proxy reporthole-pgadmin:80
	}

	@logs path /logs /logs/*
	handle @logs {
		reverse_proxy reporthole-dozzle:8080
	}

	handle {
		reverse_proxy {$FRONTEND_HOST}:{$FRONTEND_PORT} host.docker.internal:{$FRONTEND_PORT} {
			lb_policy first
			health_uri /
			health_interval 5s
		}
	}
}
