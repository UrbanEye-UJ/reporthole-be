{$CADDY_SITE_ADDRESS} {
	tls {$CADDY_TLS_MODE}

	# /api/* is owned by the Next.js BFF (app/api/[...path]/route.ts and the dedicated
	# auth/login, auth/logout, image-proxy handlers) — it reads the HttpOnly token cookie
	# server-side and forwards to the backend itself via INTERNAL_API_URL. Caddy must not
	# send /api/* straight to the backend: that skips the cookie/token translation entirely
	# (the backend has no idea about HttpOnly cookies) and is what broke login/SSE in prod.
	handle /api/incidents/events {
		reverse_proxy {$FRONTEND_HOST}:{$FRONTEND_PORT} host.docker.internal:{$FRONTEND_PORT} {
			lb_policy first
			health_uri /
			health_interval 5s
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy {$FRONTEND_HOST}:{$FRONTEND_PORT} host.docker.internal:{$FRONTEND_PORT} {
			lb_policy first
			health_uri /
			health_interval 5s
		}
	}

	# Dev/ops tooling — gated by Caddy's own basic_auth (DEV_TOOLS_USERNAME /
	# DEV_TOOLS_PASSWORD_HASH in .env), not the app's login. Deliberately not the app's
	# JWT/cookie auth: pgAdmin/Dozzle exist to debug the app, so their access gate can't
	# depend on the app (or its database) being up. Caddy enforces this itself, so it
	# holds even when reporthole-be/reporthole-ui are down or crash-looping.
	@pgadmin path /pgadmin /pgadmin/*
	handle @pgadmin {
		basic_auth {
			{$DEV_TOOLS_USERNAME} {$DEV_TOOLS_PASSWORD_HASH}
		}
		reverse_proxy reporthole-pgadmin:80
	}

	@logs path /logs /logs/*
	handle @logs {
		basic_auth {
			{$DEV_TOOLS_USERNAME} {$DEV_TOOLS_PASSWORD_HASH}
		}
		reverse_proxy reporthole-dozzle:8080
	}

	handle {
		reverse_proxy {$FRONTEND_HOST}:{$FRONTEND_PORT} host.docker.internal:{$FRONTEND_PORT} {
			lb_policy first
			health_uri /
			health_interval 5s
		}
	}
}
