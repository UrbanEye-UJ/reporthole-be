{$CADDY_SITE_ADDRESS} {
	tls {$CADDY_TLS_MODE}

	handle /api/incidents/events {
		reverse_proxy {$BACKEND_HOST}:{$BACKEND_PORT} host.docker.internal:{$BACKEND_PORT} {
			lb_policy first
			health_uri /api/actuator/health
			health_interval 5s
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy {$BACKEND_HOST}:{$BACKEND_PORT} host.docker.internal:{$BACKEND_PORT} {
			lb_policy first
			health_uri /api/actuator/health
			health_interval 5s
		}
	}

	# Dev/ops tooling — gated by Caddy's own basic_auth (DEV_TOOLS_USERNAME /
	# DEV_TOOLS_PASSWORD_HASH in .env), not the app's login. Deliberately not the app's
	# JWT/cookie auth: pgAdmin/Dozzle exist to debug the app, so their access gate can't
	# depend on the app (or its database) being up. Caddy enforces this itself, so it
	# holds even when reporthole-be/reporthole-ui are down or crash-looping.
	@pgadmin path /pgadmin /pgadmin/*
	handle @pgadmin {
		basic_auth {
			{$DEV_TOOLS_USERNAME} {$DEV_TOOLS_PASSWORD_HASH}
		}
		reverse_proxy reporthole-pgadmin:80
	}

	@logs path /logs /logs/*
	handle @logs {
		basic_auth {
			{$DEV_TOOLS_USERNAME} {$DEV_TOOLS_PASSWORD_HASH}
		}
		reverse_proxy reporthole-dozzle:8080
	}

	handle {
		reverse_proxy {$FRONTEND_HOST}:{$FRONTEND_PORT} host.docker.internal:{$FRONTEND_PORT} {
			lb_policy first
			health_uri /
			health_interval 5s
		}
	}
}
