{$CADDY_SITE_ADDRESS} {
	tls {$CADDY_TLS_MODE}

	handle /api/incidents/events {
		reverse_proxy {$BACKEND_HOST}:{$BACKEND_PORT} host.docker.internal:{$BACKEND_PORT} {
			lb_policy first
			health_uri /api/actuator/health
			health_interval 5s
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy {$BACKEND_HOST}:{$BACKEND_PORT} host.docker.internal:{$BACKEND_PORT} {
			lb_policy first
			health_uri /api/actuator/health
			health_interval 5s
		}
	}

	# Dev/ops tooling — gated on being logged into the app as SECURITY_ADMIN, not a
	# separate credential. forward_auth sends a subrequest (forwarding the original
	# request's Cookie header) to the BE's /admin/security/check-access; 2xx lets the
	# request through to pgAdmin/Dozzle, anything else is returned to the browser as-is
	# and the dev tool is never reached. Same dual-upstream pattern as /api/* below so
	# this still works when the backend runs natively (not containerized) in local dev.
	handle /pgadmin/* {
		forward_auth {$BACKEND_HOST}:{$BACKEND_PORT} host.docker.internal:{$BACKEND_PORT} {
			uri /api/admin/security/check-access
			lb_policy first
			health_uri /api/actuator/health
			health_interval 5s
		}
		reverse_proxy reporthole-pgadmin:80
	}

	handle /logs/* {
		forward_auth {$BACKEND_HOST}:{$BACKEND_PORT} host.docker.internal:{$BACKEND_PORT} {
			uri /api/admin/security/check-access
			lb_policy first
			health_uri /api/actuator/health
			health_interval 5s
		}
		reverse_proxy reporthole-dozzle:8080
	}

	handle {
		reverse_proxy {$FRONTEND_HOST}:{$FRONTEND_PORT} host.docker.internal:{$FRONTEND_PORT} {
			lb_policy first
			health_uri /
			health_interval 5s
		}
	}
}
